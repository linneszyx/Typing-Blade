+.character-option:hover:not(:disabled) { transform: translateY(-2px); border-color: color-mix(in srgb, var(--fighter-color), transparent 35%); }
+.character-option.selected { border-color: var(--fighter-color); background: color-mix(in srgb, var(--fighter-color) 8%, #0b0b15); box-shadow: inset 0 0 18px color-mix(in srgb, var(--fighter-color) 7%, transparent); }
+.character-option:disabled { cursor: default; opacity: .88; }
+.character-kanji { flex: 0 0 40px; height: 42px; display: grid; place-items: center; color: var(--fighter-color); border: 1px solid color-mix(in srgb, var(--fighter-color) 45%, transparent); background: color-mix(in srgb, var(--fighter-color) 8%, transparent); font: 800 24px 'Barlow Condensed', sans-serif; }
+.character-copy { display: flex; flex-direction: column; min-width: 0; gap: 2px; }
+.character-copy strong { font: 800 16px 'Barlow Condensed', sans-serif; letter-spacing: 1px; }
+.character-copy small { color: var(--fighter-color); font-size: 8px; letter-spacing: 1px; }
+.character-copy em { color: #7e819e; font-size: 9px; font-style: normal; line-height: 1.25; }
+.character-check { margin-left: auto; align-self: flex-start; white-space: nowrap; color: var(--fighter-color); font-size: 7px; letter-spacing: .7px; }
+@media (max-width: 700px) {
+  .character-select { padding: 12px; }
+  .character-options { grid-template-columns: 1fr; }
+  .character-option { padding: 9px; }
+  .character-copy em { font-size: 10px; }
+  .select-heading > span:last-child { max-width: 130px; text-align: right; line-height: 1.4; }
