 }
+
+
+/* Combat upgrade: readable enemy telegraphs, charged ultimate state, and input lock feedback. */
+.round-clock.incoming { color: #ff8bab; animation: dangerPulse .42s ease-in-out infinite alternate; }
+.round-clock.incoming .clock-dot { background: #ff4f91; box-shadow: 0 0 12px #ff4f91; }
+.target-hint.special-hint { color: #c7a5ff; text-shadow: 0 0 12px #9b6cff55; }
+.primary-button.charged { background: linear-gradient(100deg, #c4a0ff, #58eaff); box-shadow: 0 0 22px #9b6cff3d; }
+.primary-button:disabled { cursor: not-allowed; opacity: .48; transform: none; box-shadow: none; }
+@keyframes dangerPulse { from { opacity: .65; } to { opacity: 1; } }
